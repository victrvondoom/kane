{
  "name": "shipproof",
  "version": "1.0.0",
  "description": "Evidence-backed release verification for AI-generated software, powered by Kane CLI",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "shipproof": "cli/shipproof.js"
  },
  "scripts": {
    "shipproof": "node cli/shipproof.js",
    "shipproof:tenant": "node cli/shipproof.js tenant",
    "demo:tenant": "node demo/tenant-boundary/run-demo.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "demo:app": "node --watch demo-app/server.js",
    "demo:fix": "git apply demo/fix-coupon.patch && echo 'Coupon fix applied to demo-app/pricing.js'",
    "demo:break": "git apply -R demo/fix-coupon.patch && echo 'Coupon bug restored in demo-app/pricing.js'",
    "migrate": "node server/db.js",
    "backup": "node server/db.js backup",
    "kane:smoke": "node scripts/kane-smoke.js",
    "bench:truth": "node scripts/bench-collect-truth.mjs",
    "bench:impact": "node scripts/bench-impact.mjs",
    "bench:sbfl": "node scripts/bench-sbfl.mjs",
    "test":"node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^4.21.2"
  }
}
