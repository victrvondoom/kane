# SHIPPROOF server
PORT=4000
DATA_DIR=./data
# Set to 1 when served over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=0

# Kane CLI — the verification engine
# Path/name of the binary (npm install -g @testmuai/kane-cli)
KANE_CLI_BIN=kane-cli
# Either run `kane-cli login` once on the host, OR provide CI-style credentials here.
# These are passed to kane-cli only; they are never stored in the DB or sent to the browser.
LT_USERNAME=
LT_ACCESS_KEY=
# Per-criterion limits
KANE_TIMEOUT_SECONDS=240
KANE_MAX_STEPS=40
# 1 = headless Chrome (required on servers without a display)
KANE_HEADLESS=1

# Demo store (sample app under test)
DEMO_PORT=4100
