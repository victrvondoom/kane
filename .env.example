# SHIPPROOF server
PORT=4000
DATA_DIR=./data
# Set to 1 when served over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=0

# Behind a reverse proxy: number of proxy hops to trust for client IP / https detection (e.g. 1)
TRUST_PROXY=
# info (structured JSON request logs) or silent
LOG_LEVEL=info

# Target policy (SSRF guard). Loopback/private application URLs are refused unless this is 1.
# Keep 1 for local development and the bundled demo store; set 0 on any shared deployment.
# Link-local/metadata addresses (169.254.0.0/16) are always refused.
ALLOW_PRIVATE_TARGETS=1
# 1 = a reported pass with no collected evidence artifact is recorded as unverified
REQUIRE_EVIDENCE=1

# Kane CLI — the verification engine
# Path/name of the binary (npm install -g @testmuai/kane-cli)
KANE_CLI_BIN=kane-cli
# Either run `kane-cli login` once on the host, OR provide CI-style credentials here.
# These are passed to kane-cli only; they are never stored in the DB or sent to the browser.
LT_USERNAME=
LT_ACCESS_KEY=
# Per-criterion limits
KANE_TIMEOUT_SECONDS=240
KANE_MAX_STEPS=40
# 1 = headless Chrome (required on servers without a display)
KANE_HEADLESS=1

# Demo store (sample app under test)
DEMO_PORT=4100

# Layer 3 — proof intelligence
# Optional: derive the key that encrypts webhook secrets at rest from this value instead of a file in DATA_DIR/keys.
# The Ed25519 dossier signing key always lives in DATA_DIR/keys (back it up with the database).
SERVER_SECRET=
# Leave unset. 1 lets passes from a test stand-in engine count toward release decisions (automated tests only).
ACCEPT_FIXTURE_ENGINE=

# Demo source mutation (POST /api/demo/break-app|fix-app and the loop's built-in demo repair edit demo-app/pricing.js).
# Development/test only: ignored when NODE_ENV=production. Both must be set; only the listed accounts may mutate.
ALLOW_DEMO_MUTATIONS=
DEMO_MUTATION_USERS=
# URL of the demo store for the one-click demo project (default: http://127.0.0.1:$DEMO_PORT/)
DEMO_APP_URL=
